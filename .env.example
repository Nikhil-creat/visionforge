# Copy to .env and fill in. NEVER commit .env (it is git-ignored).

# --- Free LLM keys (either one is enough; both = council + automatic failover) ---
# Groq:   https://console.groq.com/keys
# Gemini: https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Access control ---
# Comma-separated API keys. Leave empty for open demo mode (still rate limited per IP).
API_KEYS=
# Origins allowed to call the API, comma separated, NO path and NO trailing slash.
# e.g. http://localhost:3000,https://nikhil-creat.github.io
CORS_ORIGINS=http://localhost:3000

# --- Assistant council / guardrails ---
COUNCIL_MAX_MEMBERS=4          # 2-4 recommended on free tiers (Groq free = ~30 requests/min)
GUARD_BLOCK_THRESHOLD=0.8      # prompt-injection score at/above which a request is blocked
AUDIT_ENABLED=true
VISION_LLM=true                # Gemini-vision "AI describe" (still requires per-request user consent)

# --- Limits ---
TRUSTED_PROXY_HOPS=0           # set 1 behind Render / one reverse proxy so per-IP rate limits see the real client
MAX_UPLOAD_MB=50
MAX_SIDE=2048                  # lower (1280) on 512 MB hosts
TTL_SECONDS=3600
RATE_CAPACITY=30
RATE_REFILL_PER_SEC=0.5

# --- Hosted infra (all optional; sensible in-memory fallbacks exist) ---
# Upstash Redis free tier uses TLS:  rediss://default:<password>@<host>:6379
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=                # needed for Qdrant Cloud

# --- Optional neural features (need BACKEND_TARGET=gpu or `pip install -r requirements-gpu.txt`) ---
ENABLE_CLIP=false
ENABLE_OCR=false
ENABLE_NSFW_MODEL=false

# Used by docker compose
BACKEND_TARGET=cpu
PUBLIC_API_URL=http://localhost:8000
